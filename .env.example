# cytoflowweb environment configuration
# Copy this file to .env and adjust values as needed.
# docker compose automatically reads .env from the project root.

# Host port that the web app is published on (container always uses 8000)
CYTOFLOWWEB_HOST_PORT=8000

# In-memory session LRU cap
CYTOFLOWWEB_MAX_SESSIONS=50

# Logging verbosity: debug | info | warning | error | critical
CYTOFLOWWEB_LOG_LEVEL=info
